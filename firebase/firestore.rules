rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REPLACE BOTH occurrences of  with your Firebase Authentication User UID.
    function owner() {return request.auth != null && request.auth.uid == 'GfgtFRmnbcWy8sQbS1INMSH0TiE3';}
    match /projects/{projectId} {
      allow get, list: if owner() || resource.data.published == true;
      allow create, update, delete: if owner();
    }
    match /site_settings/{docId} {
      allow get: if docId == 'main';
      allow list: if false;
      allow create, update, delete: if docId == 'main' && owner();
    }
    match /inquiries/{inquiryId} {
      allow create: if
        request.resource.data.keys().hasOnly(['name','email','phone','company','service','budget','message','status','created_at'])
        && request.resource.data.keys().hasAll(['name','email','message','status','created_at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 180
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 3000
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 25
        && request.resource.data.company is string && request.resource.data.company.size() <= 150
        && request.resource.data.service is string && request.resource.data.service.size() <= 120
        && request.resource.data.budget is string && request.resource.data.budget.size() <= 100
        && request.resource.data.status == 'new'
        && request.resource.data.created_at == request.time;
      allow get, list, update, delete: if owner();
    }
    match /{document=**} {allow read, write: if false;}
  }
}



